<UserControl x:Class="CopiMineLauncher.App.MinecraftDefaultsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource LauncherWindowBackground}"
             Foreground="{StaticResource LauncherPrimaryText}">
  <UserControl.Resources>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource LauncherPrimaryText}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Margin" Value="0,0,0,14" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="CheckBoxBorder" Width="22" Height="22" CornerRadius="6" Background="{StaticResource LauncherInputSurface}" BorderBrush="{StaticResource LauncherBorder}" BorderThickness="1" Margin="0,0,12,0">
                <Path x:Name="CheckMark" Data="M4,11 L9,16 L18,6" Stroke="{StaticResource LauncherWindowBackground}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
              </Border>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource LauncherAccent}" />
                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource LauncherAccentBright}" />
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource LauncherAccent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="34">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="760">
        <Border Style="{StaticResource LauncherCard}" Padding="26" Margin="0,0,0,16">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="46" Height="46" Background="{StaticResource LauncherSurfaceRaised}" CornerRadius="13" Padding="9" Margin="0,0,14,0">
                <Image Source="Assets/LauncherVisuals/copimine-icon.png" Stretch="Uniform" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ПЕРВЫЙ ЗАПУСК" Foreground="{StaticResource LauncherAccent}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="Настройка Minecraft" FontSize="25" FontWeight="Bold" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="Выберите стартовые параметры игры. Их можно изменить позже в настройках Minecraft." Foreground="{StaticResource LauncherSecondaryText}" FontSize="14" TextWrapping="Wrap" Margin="0,22,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource LauncherCard}" Padding="26">
          <StackPanel>
            <TextBlock Text="Параметры по умолчанию" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18" />
            <CheckBox Content="Русский язык" IsChecked="{Binding UseRussianLanguageDefault, Mode=TwoWay}" />
            <CheckBox Content="Отключить диктора" IsChecked="{Binding DisableNarratorDefault, Mode=TwoWay}" />
            <CheckBox Content="Общая громкость — 15%" IsChecked="{Binding SetMasterVolumeToFifteenPercentDefault, Mode=TwoWay}" Margin="0" />
            <TextBlock Text="Выбранные значения применяются только если игрок ещё не менял этот параметр." Foreground="{StaticResource LauncherMutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="1" Margin="0,22,0,0">
      <TextBlock Text="Minecraft установится в выбранную при установке папку." Foreground="{StaticResource LauncherMutedText}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440" />
      <Button Content="Сохранить и продолжить" Style="{StaticResource LauncherPrimaryButton}" Click="Save_Click" HorizontalAlignment="Right" Margin="12,0,0,0" />
    </DockPanel>
  </Grid>
</UserControl>
