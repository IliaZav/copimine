                }
              }
            }
          ],
          "message": {
            "text": "The default backup destination is a release backup directory, and Get-ChildItem -Force enumerates every project-root entry before Copy-Item -Recurse stages it for Compress-Archive. This includes hidden .env and password files when present, as well as runtime data and logs. The output is a cleartext ZIP with only a SHA256 sidecar; no redaction, encryption, or separate secret handling is applied, so possession of the backup exposes stored credentials and session material."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:7088dec0843b069ffc863ffbc368ce4b594e539c5bea9540de3f87eb5e8f2902"
