<Window x:Class="CopiMineLauncher.App.SkinManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Скины и плащи — CopiMine"
        Width="1240" Height="800" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#0b141c" Foreground="#eef7f5">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#edf7f4" />
      <Setter Property="Background" Value="#173044" />
      <Setter Property="BorderBrush" Value="#2c5367" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#21445b" />
          <Setter Property="BorderBrush" Value="#4a7b91" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#45d483" />
      <Setter Property="Foreground" Value="#06150d" />
      <Setter Property="BorderBrush" Value="#7af0aa" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0c1925" />
      <Setter Property="Foreground" Value="#eef7f5" />
      <Setter Property="BorderBrush" Value="#2b5367" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,5,0,8" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#0c1925" />
      <Setter Property="Foreground" Value="#eef7f5" />
      <Setter Property="BorderBrush" Value="#2b5367" />
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="Margin" Value="0,5,0,8" />
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="ВНЕШНИЙ ВИД" Foreground="#63dfa0" FontSize="12" FontWeight="Bold" />
      <TextBlock Text="Скины и плащи" FontSize="28" FontWeight="Bold" Margin="0,3,0,0" />
      <TextBlock Text="Выберите скин или плащ. Крутите модель мышью." Foreground="#9eb8c3" Margin="0,5,0,0" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="310" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="270" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#122332" BorderBrush="#284858" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,12,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Text="Каталог скинов" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Каталог Ely.by" Foreground="#718b96" FontSize="11" Margin="0,4,0,10" TextWrapping="Wrap" />
            <TextBox x:Name="TagsTextBox" ToolTip="Например: winter, fantasy" />
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="SortComboBox" SelectedIndex="0" SelectionChanged="CatalogFilterChanged">
              <ComboBoxItem Content="Популярные" Tag="best" />
              <ComboBoxItem Content="Новые" Tag="time" />
            </ComboBox>
            <ComboBox Grid.Column="1" x:Name="TypeComboBox" SelectedIndex="0" SelectionChanged="CatalogFilterChanged" Margin="7,5,0,8">
              <ComboBoxItem Content="Все модели" Tag="any" />
              <ComboBoxItem Content="Slim / Alex" Tag="slim" />
              <ComboBoxItem Content="Classic / Steve" Tag="new" />
            </ComboBox>
          </Grid>
          <StackPanel Grid.Row="2">
            <CheckBox x:Name="SensitiveCheckBox" Content="Показывать чувствительный контент" Foreground="#b1c7ce" Margin="0,0,0,8" />
            <Button Content="Загрузить каталог" Click="LoadCatalog_Click" />
          </StackPanel>
          <TabControl Grid.Row="3" Background="#0c1925" BorderBrush="#284858" BorderThickness="1" Foreground="#eef7f5">
            <TabItem Header="Скины" Padding="10,5">
              <ListBox x:Name="CatalogListBox" SelectionChanged="CatalogSelectionChanged" Background="#0c1925" BorderThickness="0" Foreground="#eef7f5" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#102333" BorderBrush="#284858" BorderThickness="1" CornerRadius="8" Padding="9" Margin="3">
                      <StackPanel>
                        <DockPanel>
                          <TextBlock Text="Скин" Foreground="#7af0aa" FontWeight="Bold" />
                          <TextBlock Text="{Binding Id, StringFormat=№ {0}}" Foreground="#718b96" DockPanel.Dock="Right" />
                        </DockPanel>
                        <TextBlock Text="{Binding Tags, StringFormat=Теги: {0}}" Foreground="#b1c7ce" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding IsSlim, StringFormat=Модель Slim: {0}}" Foreground="#718b96" FontSize="11" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
            <TabItem Header="Плащи по нику" Padding="10,5">
              <Grid Background="#0c1925">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Плащи для выбранного ника" Foreground="#718b96" FontSize="11" TextWrapping="Wrap" Margin="8,8,8,6" />
                <ListBox Grid.Row="1" x:Name="CapeListBox" SelectionChanged="CapeSelectionChanged" Background="#0c1925" BorderThickness="0" Foreground="#eef7f5" ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#102333" BorderBrush="#284858" BorderThickness="1" CornerRadius="8" Padding="9" Margin="3">
                        <StackPanel>
                          <DockPanel>
                            <TextBlock Text="Плащ" Foreground="#7af0aa" FontWeight="Bold" />
                            <TextBlock Text="{Binding Type}" Foreground="#b1c7ce" DockPanel.Dock="Right" />
                          </DockPanel>
                          <TextBlock Text="{Binding PlayerName, StringFormat=Ник: {0}}" Foreground="#718b96" FontSize="11" Margin="0,5,0,0" />
                          <TextBlock Text="{Binding Animated, StringFormat=Анимация источника: {0}}" Foreground="#718b96" FontSize="11" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </TabItem>
          </TabControl>
          <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="CatalogPageLabel" Text="Каталог ещё не загружен" Foreground="#718b96" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button x:Name="NextPageButton" Content="Дальше →" Click="NextPage_Click" IsEnabled="False" Padding="9,6" Margin="8,0,0,0" DockPanel.Dock="Right" />
          </DockPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="#0c1925" BorderBrush="#284858" BorderThickness="1" CornerRadius="14" Padding="8" Margin="0,0,12,0">
        <Grid>
          <wv2:WebView2 x:Name="PreviewView" />
          <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="#09111a" Opacity="0.88" CornerRadius="7" Padding="9,6" Margin="10">
            <TextBlock x:Name="PreviewStatus" Text="Предпросмотр готов" Foreground="#b1c7ce" FontSize="11" />
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="#122332" BorderBrush="#284858" BorderThickness="1" CornerRadius="14" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Мой образ" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Ваш ник" Foreground="#718b96" FontSize="11" Margin="0,4,0,6" TextWrapping="Wrap" />
            <TextBox x:Name="PlayerNameTextBox" />
            <Button Content="Найти по нику" Click="ResolveByNickname_Click" />
            <Button Content="Загрузить плащи" Click="LoadCapes_Click" />
            <TextBlock x:Name="SourceLabel" Text="Ничего не выбрано" Foreground="#9eb8c3" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

            <Separator Background="#284657" Margin="0,0,0,12" />
            <TextBlock Text="Файлы" Foreground="#9eb8c3" FontWeight="SemiBold" />
            <Button Content="Загрузить скин из файла" Click="ImportSkin_Click" />
            <Button Content="Загрузить плащ из файла" Click="ImportCape_Click" />
            <Button Content="Применить скин" Style="{StaticResource PrimaryButton}" Click="ApplySkin_Click" />
            <Button Content="Применить плащ" Click="ApplyCape_Click" />
            <TextBlock Text="Файлы лежат в папке игры. После смены перезапустите Minecraft." Foreground="#718b96" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,12" />

            <Separator Background="#284657" Margin="0,0,0,12" />
            <TextBlock Text="Предпросмотр" Foreground="#9eb8c3" FontWeight="SemiBold" />
            <TextBlock Text="Модель" Foreground="#718b96" FontSize="11" />
            <ComboBox x:Name="ModelComboBox" SelectionChanged="PreviewSettingChanged">
              <ComboBoxItem Content="Авто" Tag="auto-detect" />
              <ComboBoxItem Content="Steve · обычные руки" Tag="default" />
              <ComboBoxItem Content="Alex · тонкие руки" Tag="slim" />
            </ComboBox>
            <TextBlock Text="Анимация" Foreground="#718b96" FontSize="11" />
            <ComboBox x:Name="AnimationComboBox" SelectionChanged="PreviewSettingChanged">
              <ComboBoxItem Content="Ходьба" Tag="walking" />
              <ComboBoxItem Content="Покой" Tag="idle" />
              <ComboBoxItem Content="Бег" Tag="running" />
              <ComboBoxItem Content="Мах рукой" Tag="wave" />
              <ComboBoxItem Content="Приседание" Tag="crouch" />
              <ComboBoxItem Content="Полёт" Tag="flying" />
              <ComboBoxItem Content="Плавание" Tag="swim" />
              <ComboBoxItem Content="Получение урона" Tag="hit" />
            </ComboBox>
            <TextBlock Text="Фон" Foreground="#718b96" FontSize="11" />
            <ComboBox x:Name="BackgroundComboBox" SelectionChanged="PreviewSettingChanged">
              <ComboBoxItem Content="Ледяная долина" Tag="ice" />
              <ComboBoxItem Content="Ночное небо" Tag="night" />
              <ComboBoxItem Content="Лес" Tag="forest" />
              <ComboBoxItem Content="Закат" Tag="sunset" />
              <ComboBoxItem Content="Тёмный фон" Tag="clean" />
            </ComboBox>
            <CheckBox x:Name="AutoRotateCheckBox" Content="Автоповорот" IsChecked="True" Click="PreviewSettingChanged" Foreground="#eef7f5" Margin="0,0,0,8" />
            <TextBlock Text="Скорость анимации" Foreground="#718b96" FontSize="11" />
            <Slider x:Name="AnimationSpeedSlider" Minimum="0.25" Maximum="2.5" Value="1" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="PreviewSettingChanged" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" Text="Готово" Foreground="#9eb8c3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Button Content="Закрыть" Click="Close_Click" Padding="16,8" Margin="8,0,0,0" DockPanel.Dock="Right" />
    </DockPanel>
  </Grid>
</Window>
