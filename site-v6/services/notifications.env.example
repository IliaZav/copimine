# Server-only environment. Do not place this file in a public web root.
# The HTML preview cannot read these secrets and never calls a provider.
# Use live only after configuring your own provider credentials. The standalone
# `python services/notifications.py --preview` command remains local-only.
CM_NOTIFY_MODE=disabled
CM_SMTP_HOST=
CM_SMTP_PORT=587
CM_SMTP_TLS=starttls
CM_SMTP_USER=
CM_SMTP_PASSWORD=
CM_SMTP_FROM=
CM_SMSRU_API_ID=
CM_SMSRU_SENDER=
# Rolling 24-hour budgets include both queued and attempted messages.
CM_NOTIFY_EMAIL_DAILY_LIMIT=1000
CM_NOTIFY_SMS_DAILY_LIMIT=100
