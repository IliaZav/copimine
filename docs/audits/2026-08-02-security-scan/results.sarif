          "message": {
            "text": "The player refresh endpoint invokes rotate_auth_pair_from_refresh_sync. That function verifies the old token by reading its row, commits a new token through make_refresh_token/save_refresh_session, and only afterward revokes the old row through a separate transaction. There is no row lock, conditional used-state update, or transaction spanning verification, issuance, and revocation, so concurrent requests can both pass the old-row checks and receive valid replacement sessions."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:f1546be49d3c1755f33c5954c16258d85529e20dc1c9ed9daeba7fee01603062"
