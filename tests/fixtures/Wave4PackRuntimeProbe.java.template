import java.util.*;
import java.util.logging.*;
import me.copimine.endevent.domain.*;

/** In-memory boundary only. All pack/retry/rollback/completion code is extracted unchanged. */
public class Wave4PackRuntimeProbe {
    enum Wave4PressurePackResult { COMPLETE, RETRYABLE_FAILURE, PERMANENT_FAILURE }
    enum EntityType { SPIDER, ENDERMAN, SKELETON, ZOMBIE, GIANT, OTHER }
    enum ObeliskStage {
        GROUND_WARNING, EMERGE_BASE, EMERGE_LOWER, EMERGE_CORE, EMERGE_UPPER,
        EMERGE_CROWN, AWAKEN, ACTIVE, COLLAPSING
    }
    static class PersistentDataType { static final Object STRING = new Object(); }
    static class Data {
        Map<Object, String> values = new HashMap<>();
        void set(Object key, Object type, String value) { values.put(key, value); }
    }
    static class Entity {
        UUID id = UUID.randomUUID(); EntityType type; boolean valid = true;
        long generation = 5; Data data = new Data();
        Entity(EntityType type) { this.type = type; }
        Location getLocation() { return new Location(); }
        UUID getUniqueId() { return id; }
        EntityType getType() { return type; }
        Data getPersistentDataContainer() { return data; }
        boolean isValid() { return valid; }
        boolean isDead() { return !valid; }
        void remove() { valid = false; }
    }
    static class LivingEntity extends Entity {
        LivingEntity(EntityType type) { super(type); }
        void setCustomName(String name) { }
        void setCustomNameVisible(boolean visible) { }
        AttributeInstance getAttribute(Object key) { return new AttributeInstance(); }
        void setHealth(double value) { }
    }
    static class Mob extends LivingEntity {
        Mob(EntityType type) { super(type); }
        void setAI(boolean value) { }
        void setAware(boolean value) { }
        void setTarget(Player target) { }
    }
    static class Player { }
    static class AttributeInstance { void setBaseValue(double value) { } }
    static class Attribute {
        static final Object GENERIC_MAX_HEALTH = new Object();
        static final Object GENERIC_ATTACK_DAMAGE = new Object();
    }
    static class World {
        List<Entity> entities = new ArrayList<>();
        List<Entity> getEntities() { return entities; }
    }
    static class Bukkit {
        static World world = new World();
        static World getWorld(String name) { return world; }
        static List<World> getWorlds() { return List.of(world); }
        static Entity getEntity(UUID id) {
            return world.entities.stream().filter(e -> e.id.equals(id)).findFirst().orElse(null);
        }
    }
    static class Location { }
    static class ChatColor { static final String DARK_PURPLE = ""; }
    static class EventConfig {
        static class RiftObeliskTuning {
            int maxActiveFireballs() { return 1; }
            int fireIntervalTicks() { return 26; }
        }
        RiftObeliskTuning riftObeliskTuning() { return new RiftObeliskTuning(); }
        double containmentRadius() { return 20.0; }
    }
    static class Wave4ObeliskRuntimeState {
        UUID id = UUID.randomUUID(); ObeliskFireDirectorPolicy.FireSequence fireLease;
        Object pulseLease, fireAim;
        ObeliskStage stage = ObeliskStage.ACTIVE;
        int currentHealth = 3, maxHealth = 3;
        long emergenceStartTick, activationTick, stageStartedTick, nextPulseTick,
                nextFireTick, destroyAtTick = -1L;
        boolean fractureCuePlayed;
        UUID id() { return id; }
        ObeliskStage stage() { return stage; }
        void stage(ObeliskStage value, long tick) { stage = value; stageStartedTick = tick; }
        int health() { return currentHealth; }
        int maxHealth() { return maxHealth; }
        void health(int value) { currentHealth = Math.max(0, Math.min(maxHealth, value)); }
        long emergenceStartTick() { return emergenceStartTick; }
        long activationTick() { return activationTick; }
        long stageStartedTick() { return stageStartedTick; }
        long nextPulseTick() { return nextPulseTick; }
        void scheduleNextPulse(long tick) { nextPulseTick = tick; }
        long nextFireTick() { return nextFireTick; }
        long lastFireTick() { return 0; }
        void scheduleNextFire(long tick) { nextFireTick = tick; }
        long destroyAtTick() { return destroyAtTick; }
        void destroyAt(long tick) { destroyAtTick = tick; }
        UUID lastTargetUuid() { return null; }
        void lastFireTick(long tick) { }
    }
    static class RiftFireballRuntimeState { UUID originObeliskId() { return null; } }
    static class Coordinator { boolean valid(Object lease, long gen, long tick) { return false; } }
    static class EndRiftObjective { static String objective(int wave) { return "OBELISKS"; } }

    final Object keyWave4PressureSlot = "slot", keyObeliskWave4Role = "role", keyWave = "wave", keyKind = "kind";
    final String EVENT_KIND_WAVE_MOB = "mob", EVENT_KIND_ELITE = "elite";
    Set<String> currentWave4PressureSpawnSlots = new LinkedHashSet<>();
    Map<UUID, Entity> ownedEntities = new LinkedHashMap<>();
    Map<UUID, Wave4ObeliskRuntimeState> activeWave4Obelisks = new LinkedHashMap<>();
    Map<Integer, Object> currentWave4DestroyedObeliskReceipts = new HashMap<>();
    Map<UUID, RiftFireballRuntimeState> activeRiftFireballs = new HashMap<>();
    Map<UUID, UUID> waveChannelerObelisks = new HashMap<>();
    Map<Object, Object> currentWave4CollapseTransforms = new HashMap<>(), currentWave4ObeliskCells = new HashMap<>();
    Set<Object> currentWave4ConsumedFireballs = new HashSet<>();
    EventConfig config = new EventConfig(); Coordinator waveCombatCoordinator = new Coordinator();
    EventPhase phase = EventPhase.WAVE_4;
    int currentWaveScalePlayers = 2, currentWave4PressurePackAttempts, waveSpawnGroupIndex, activeWave = 4;
    long generation = 5, eventTickCounter = 5, currentWave4PressureRetryAtMillis, phaseDeadlineMillis;
    String eventId = UUID.randomUUID().toString(), worldName = "fixture", recoveryReason;
    boolean testWave4ObeliskMode, testWaveFrontVisualMode, currentWave4MobsStarted,
            currentWave4StartupFailed, currentWave4ObeliskAssaultComplete, waveObjectiveComplete;
    WaveMechanicsPolicy.WaveCounts composition = new WaveMechanicsPolicy.WaveCounts(2, 4, 0, 0, 0);
    List<WaveMechanicsPolicy.WaveCounts> waveSpawnSchedule = List.of(composition);
    Set<Integer> failing = new HashSet<>(), throwAfterRegister = new HashSet<>(), refusingSpawn = new HashSet<>();
    List<Integer> spawnCalls = new ArrayList<>();
    int canceled, announced; boolean rejectRegistration, removeSpiderDuringSpawn;
    double WAVE_MOB_DAMAGE_REDUCTION = 0.0D;

    Wave4PackRuntimeProbe() {
        Bukkit.world = new World();
        var obelisk = new Wave4ObeliskRuntimeState(); activeWave4Obelisks.put(obelisk.id, obelisk);
    }
    Logger getLogger() { return Logger.getLogger("Wave4PackRuntimeProbe"); }
    String readString(Entity e, Object key) { return e == null ? "" : e.data.values.getOrDefault(key, ""); }
    int readInt(Entity e, Object key, int fallback) {
        String value = readString(e, key); return value.isEmpty() ? fallback : Integer.parseInt(value);
    }
    boolean ownedBySession(Entity e, String event, long gen) { return e.generation == gen; }
    void unregisterOwnedEntity(UUID id, String reason) { ownedEntities.remove(id); }
    Entity spawn(EntityType type, int index) {
        spawnCalls.add(index); if (failing.contains(index)) return null;
        if (refusingSpawn.remove(index)) {
            var refused = new Mob(type); refused.generation = generation; refused.valid = false;
            refused.data.values.put(keyWave, "4"); refused.data.values.put(keyKind, EVENT_KIND_WAVE_MOB);
            Bukkit.world.entities.add(refused);
            return refused;
        }
        if (removeSpiderDuringSpawn && index == 1) {
            removeSpiderDuringSpawn = false;
            Entity stalker = ownedEntities.values().stream()
                    .filter(entity -> entity.getType() == EntityType.SPIDER).findFirst().orElseThrow();
            unregisterOwnedEntity(stalker.id, "synchronous-spawn-callback");
            stalker.remove();
        }
        var e = new Mob(type); e.generation = generation;
        e.data.values.put(keyWave, "4"); e.data.values.put(keyKind, EVENT_KIND_WAVE_MOB);
        Bukkit.world.entities.add(e);
        if (!rejectRegistration) ownedEntities.put(e.id, e);
        if (throwAfterRegister.remove(index)) throw new IllegalStateException("spawn failed after registration");
        return e;
    }
    Entity spawnOwnedMob(World world, Location core, EntityType type, int wave, String kind, boolean test, int index) {
        return spawn(type, index);
    }
    Entity spawnRiftGiantElite(World world, Location core, int wave, boolean test, int index) {
        return spawn(EntityType.ZOMBIE, index);
    }
    Entity spawnEnderman(World world, Location core, int wave, boolean elite, boolean boss, boolean test, int index, int offset) {
        return spawn(EntityType.ENDERMAN, index);
    }
    Entity spawnSkeleton(World world, Location core, int wave, boolean elite, boolean boss, boolean test, int index, int offset) {
        return spawn(EntityType.SKELETON, index);
    }
    WaveMechanicsPolicy.WaveCounts currentWave4MobCounts(int players) { return composition; }
    Location coreCombatAnchorLocation() { return new Location(); }
    Player ritualNearestTarget(Location origin, double radius) { return null; }
    double boundedCombatRadius(double radius) { return radius; }
    boolean isOfficialCurrentAttempt() { return phase == EventPhase.WAVE_4; }
    boolean isOfficialAttempt() { return !testWaveFrontVisualMode; }
    void forcePhase(EventPhase next, String reason) { phase = next; }
    void cancelWaveSpawnTask() { canceled++; }
    void removeWave4Obelisk(UUID id, String reason) { activeWave4Obelisks.remove(id); }
    void cleanupRiftFireball(UUID id, String reason) { activeRiftFireballs.remove(id); }
    ObeliskFireDirectorPolicy.SpecialCandidate selectWave4Special() { return null; }
    void renderObeliskCollapse(Wave4ObeliskRuntimeState state) { }
    void advanceObeliskEmergence(Wave4ObeliskRuntimeState state) { }
    void applyObeliskStageBlocks(Wave4ObeliskRuntimeState state, ObeliskStage stage) { }
    void ensureCurrentObeliskVisuals(Wave4ObeliskRuntimeState state, ObeliskStage stage) { }
    void renderObeliskActive(Wave4ObeliskRuntimeState state) { }
    void clearWaveCombatCue(UUID id) { }
    void tickWave4Pulse(Wave4ObeliskRuntimeState state, EventConfig.RiftObeliskTuning tuning) { }
    void renderWave4ChannelerBeams() { }
    int activeWave4FireballCount() { return 0; }
    boolean launchWave4Fireball(Wave4ObeliskRuntimeState state) { return false; }
    void tickRiftFireballs() { }
    boolean tickWaveObjective() { return tickWave4ObeliskAssault(); }
    void clearWaveCombatEntities(String reason) { clearWave4PressurePackEntities(reason); }
    int countLiveWaveEntitiesForWave(int wave) { return liveCount(); }
    boolean spawnWaveCompletionLoot(int wave) { return true; }
    void announceWaveComplete(int wave) { announced++; }
    boolean clearWaveObjectiveState() { clearWave4Obelisks("completed"); return true; }
    void saveStateAsync() { }
    int liveCount() {
        return (int) ownedEntities.values().stream().filter(e -> isLiveOwnedEntity(e.id)
                && ownedBySession(e, eventId, generation)).count();
    }
    Wave4PressurePackResult pack() {
        return spawnWave4PressurePack(Bukkit.world, new Location(),
                ObeliskScalingPolicy.profileForPlayers(currentWaveScalePlayers), false);
    }
    void retryNow() { currentWave4PressureRetryAtMillis = 0; tickWave4ObeliskAssault(); }
    static void check(boolean condition, String message) { if (!condition) throw new AssertionError(message); }
    static void completePack(Wave4PackRuntimeProbe p) {
        int expected = ObeliskScalingPolicy.profileForPlayers(p.currentWaveScalePlayers).mobCount();
        check(p.currentWave4MobsStarted && p.liveCount() == expected,
                "complete requires every live slot in the scaled pressure pack");
        check(p.ownedEntities.values().stream().map(e -> p.readString(e, p.keyWave4PressureSlot)).distinct().count() == expected,
                "complete pack must have unique stable slots");
        for (Entity e : p.ownedEntities.values())
            check(p.readString(e, p.keyWave4PressureSlot).startsWith(p.inferredWave4Role(e) + ":"), "role identity changed");
    }
    public static void main(String[] args) {
        Logger.getLogger("Wave4PackRuntimeProbe").setLevel(Level.OFF);
        var p = new Wave4PackRuntimeProbe(); String scenario = args[0];
        switch (scenario) {
            case "restore-emergence" -> {
                var state = new Wave4ObeliskRuntimeState();
                state.stage(ObeliskStage.GROUND_WARNING, 0L);
                p.eventTickCounter = 200L;
                p.applyRestoredObeliskReceipt(state,
                        new Wave4ObeliskRecoverySnapshot.ObeliskReceipt(0, 3, 3, "EMERGE_CORE"));
                check(state.stage() == ObeliskStage.EMERGE_CORE,
                        "restored Wave 4 emergence stage must resume from its checkpoint");
            }
            case "restore-timing" -> {
                String[] stages = {"GROUND_WARNING", "EMERGE_BASE", "EMERGE_LOWER",
                        "EMERGE_CORE", "EMERGE_UPPER", "EMERGE_CROWN", "AWAKEN"};
                long[] elapsed = {5L, 14L, 29L, 35L, 45L, 55L, 65L};
                long[] offsets = {0L, 10L, 20L, 30L, 40L, 50L, 60L};
                p.eventTickCounter = 3L;
                for (int index = 0; index < stages.length; index++) {
                    var state = new Wave4ObeliskRuntimeState();
                    var receipt = new Wave4ObeliskRecoverySnapshot.ObeliskReceipt(
                            0, 3, 3, stages[index], elapsed[index], 0L, 0L, 0L);
                    p.applyRestoredObeliskReceipt(state, receipt);
                    check(state.stage().name().equals(stages[index]), "restore changed the saved emergence stage");
                    check(state.emergenceStartTick == 3L - elapsed[index],
                            "restore must preserve elapsed emergence ticks across event-counter reset");
                    check(state.activationTick == 73L - elapsed[index],
                            "restore must preserve the original activation countdown");
                    check(state.stageStartedTick == 3L - (elapsed[index] - offsets[index]),
                            "restore must preserve elapsed time within the current emergence stage");
                }
                var active = new Wave4ObeliskRuntimeState();
                p.applyRestoredObeliskReceipt(active,
                        new Wave4ObeliskRecoverySnapshot.ObeliskReceipt(
                                0, 2, 3, "ACTIVE", 70L, 9L, 4L, 0L));
                check(active.nextPulseTick == 12L && active.nextFireTick == 7L,
                        "active attacks must use saved remaining cooldowns");
                var collapsing = new Wave4ObeliskRuntimeState();
                p.applyRestoredObeliskReceipt(collapsing,
                        new Wave4ObeliskRecoverySnapshot.ObeliskReceipt(
                                0, 0, 3, "COLLAPSING", 70L, 0L, 0L, 3L));
                check(collapsing.destroyAtTick == 6L,
                        "collapse must keep only its saved remaining animation ticks");
            }
            case "pressure-matrix" -> {
                p.currentWaveScalePlayers = 16;
                p.composition = new WaveMechanicsPolicy.WaveCounts(4, 10, 2, 0, 0);
                check(p.pack() == Wave4PressurePackResult.COMPLETE,
                        "the max-roster pressure pack must materialize all planned replacements");
                check(p.liveCount() == 16 && p.currentWave4PressureSpawnSlots.size() == 16,
                        "the Zombie and Giant must replace ordinary slots without growing the pack");
                check(p.ownedEntities.values().stream()
                                .filter(e -> e.type == EntityType.ZOMBIE
                                        && "ZOMBIE".equals(p.readString(e, p.keyObeliskWave4Role))).count() == 1
                                && p.ownedEntities.values().stream()
                                .filter(e -> e.type == EntityType.ZOMBIE
                                        && "RIFT_GIANT".equals(p.readString(e, p.keyObeliskWave4Role))).count() == 1,
                        "one normal Zombie and one scaled zombie-base Rift Giant must be present at the max roster");
                int calls = p.spawnCalls.size(); p.pack();
                check(p.spawnCalls.size() == calls, "completed replacement slots must not duplicate");
            }
            case "success" -> {
                p.retryNow(); completePack(p); p.retryNow();
                check(p.spawnCalls.size() == 6, "completed pack must not spawn again");
                check(p.ownedEntities.values().stream()
                                .filter(e -> e.type == EntityType.ZOMBIE).count() == 1,
                        "normal roster should materialize one Zombie pressure mob");
            }
            case "first", "middle", "last", "all", "lost-slot", "obelisk-complete" -> {
                int failed = scenario.equals("first") ? 0 : scenario.equals("middle") ? 2 : 5;
                p.failing.add(failed);
                if (scenario.equals("all")) p.failing.addAll(List.of(0, 1, 2, 3, 4, 5));
                p.retryNow();
                check(!p.currentWave4MobsStarted && p.waveSpawnGroupIndex == 0, "partial creation accepted as started");
                if (scenario.equals("obelisk-complete")) {
                    p.activeWave4Obelisks.clear(); p.currentWave4ObeliskAssaultComplete = true;
                    p.tickWaveCompletion();
                    check(p.announced == 1 && p.liveCount() == 0, "obelisk completion must release pending pressure schedule");
                    check(p.spawnCalls.size() == 6, "destroyed obelisks must not trigger pressure retry");
                    break;
                }
                if (scenario.equals("lost-slot")) {
                    Entity lost = p.ownedEntities.values().iterator().next();
                    p.ownedEntities.remove(lost.id); lost.remove();
                }
                int before = p.spawnCalls.size();
                int missing = ObeliskScalingPolicy.profileForPlayers(p.currentWaveScalePlayers).mobCount()
                        - p.liveCount();
                p.failing.clear(); p.retryNow(); completePack(p);
                check(p.spawnCalls.size() - before == missing, "retry must attempt only missing live roles");
            }
            case "backoff" -> {
                p.failing.add(1); p.retryNow(); int calls = p.spawnCalls.size();
                p.currentWave4PressureRetryAtMillis = Long.MAX_VALUE; p.tickWave4ObeliskAssault();
                check(p.spawnCalls.size() == calls && p.currentWave4PressurePackAttempts == 1, "backoff ignored");
                p.failing.clear(); p.retryNow(); completePack(p);
            }
            case "throw-after-partial-success" -> {
                p.throwAfterRegister.add(1);
                p.retryNow();
                check(p.currentWave4PressurePackAttempts == 1 && !p.currentWave4MobsStarted,
                        "spawner exception must count as a retryable attempt");
                check(p.currentWave4PressureRetryAtMillis > System.currentTimeMillis(),
                        "spawner exception must enter normal retry backoff");
                check(p.currentWave4PressureSpawnSlots.isEmpty() && p.liveCount() == 0
                                && Bukkit.world.entities.stream().noneMatch(Entity::isValid),
                        "throw-after-registration must roll back every entity owned by the failed attempt");
                int calls = p.spawnCalls.size(); p.tickWave4ObeliskAssault();
                check(p.spawnCalls.size() == calls, "failed attempt must respect retry backoff");
                p.throwAfterRegister.clear(); p.retryNow(); completePack(p);
                check(p.spawnCalls.equals(List.of(0, 1, 0, 1, 2, 3, 4, 5)),
                        "retry after rollback must spawn each slot once without duplicate ownership");
            }
            case "throw-preserves-prior-slot" -> {
                p.failing.addAll(List.of(1, 2, 3, 4, 5)); p.retryNow();
                check(p.liveCount() == 1 && p.currentWave4PressureSpawnSlots.contains("STALKER:0"),
                        "setup must retain the accepted slot from the prior attempt");
                p.failing.clear(); p.throwAfterRegister.add(2); p.retryNow();
                check(p.currentWave4PressurePackAttempts == 2 && !p.currentWave4MobsStarted,
                        "later spawner exception must be returned through normal attempt accounting");
                check(p.liveCount() == 1 && p.currentWave4PressureSpawnSlots.equals(Set.of("STALKER:0")),
                        "rollback must preserve earlier accepted ownership and remove only this attempt's mobs");
                int calls = p.spawnCalls.size(); p.tickWave4ObeliskAssault();
                check(p.spawnCalls.size() == calls, "failed retry must respect normal backoff");
                p.throwAfterRegister.clear(); p.retryNow(); completePack(p);
                check(p.spawnCalls.equals(List.of(0, 1, 2, 3, 4, 5, 1, 2, 1, 2, 3, 4, 5)),
                        "recovery must spawn only missing roles and keep prior ownership unique");
            }
            case "registration-refused" -> {
                p.rejectRegistration = true; p.retryNow();
                check(!p.currentWave4MobsStarted && p.currentWave4PressureSpawnSlots.isEmpty(),
                        "returned but unregistered entities must not complete the pack");
                check(Bukkit.world.entities.stream().noneMatch(Entity::isValid), "registration refusal left orphan mobs");
                p.rejectRegistration = false; p.retryNow(); completePack(p);
            }
            case "ring-spawn-relocation" -> {
                p.refusingSpawn.add(2);
                Entity ring = p.spawnLiveRingEntity(2, i -> p.spawn(EntityType.SPIDER, i));
                check(ring != null && p.spawnCalls.equals(List.of(2, 3)),
                        "the shared ring spawner must relocate past a refused cell");
                check(p.liveCount() == 1, "a refused cell must not leave an orphan owned actor");
            }
            case "synchronous-slot-loss" -> {
                p.removeSpiderDuringSpawn = true;
                p.retryNow();
                check(!p.currentWave4MobsStarted && p.liveCount() == 5,
                        "synchronous spawn callback must not accept a pack missing its earlier Stalker");
                check(!p.currentWave4PressureSpawnSlots.contains("STALKER:0") && p.waveSpawnGroupIndex == 0,
                        "final slot reconciliation must leave the removed Stalker pending");
                p.retryNow(); completePack(p);
                check(p.spawnCalls.equals(List.of(0, 1, 2, 3, 4, 5, 0)),
                        "retry after synchronous loss must create only the missing Stalker");
            }
            case "exhaustion", "permanent" -> {
                Entity unrelated = p.spawn(EntityType.OTHER, 99); unrelated.data.values.put(p.keyWave, "3");
                p.spawnCalls.clear(); p.failing.add(1);
                if (scenario.equals("permanent")) p.composition = new WaveMechanicsPolicy.WaveCounts(0, 0, 0, 0, 0);
                int attempts = scenario.equals("permanent") ? 1 : Wave4PressurePackPolicy.MAX_TOTAL_ATTEMPTS;
                for (int n = 0; n < attempts; n++) p.retryNow();
                check(p.currentWave4StartupFailed && !p.currentWave4MobsStarted, "exhaustion must fail closed");
                check(p.currentWave4PressureSpawnSlots.isEmpty() && p.ownedEntities.size() == 1 && unrelated.valid,
                        "rollback must remove only pressure pack entities");
                check(p.canceled == 1, "exhaustion must cancel schedule");
                int calls = p.spawnCalls.size(); p.retryNow(); p.retryNow();
                check(p.spawnCalls.size() == calls && p.phase == EventPhase.RECOVERY_REQUIRED, "exhausted attempt retried");
            }
            case "duplicate-slot" -> {
                p.pack(); Entity original = p.ownedEntities.values().iterator().next();
                Entity duplicate = p.spawn(original.type, 99);
                duplicate.data.values.put(p.keyWave4PressureSlot, p.readString(original, p.keyWave4PressureSlot));
                duplicate.data.values.put(p.keyObeliskWave4Role, p.inferredWave4Role(original));
                p.retryNow(); completePack(p);
            }
            case "restart" -> {
                p.failing.add(1); p.pack();
                // Rehydrate the same persisted registered entities into a fresh adapter.
                var restored = new Wave4PackRuntimeProbe(); restored.ownedEntities.putAll(p.ownedEntities);
                Bukkit.world.entities.addAll(p.ownedEntities.values()); restored.retryNow(); completePack(restored);
                check(restored.spawnCalls.equals(List.of(1)), "rehydration must retry only missing role");
                restored.currentWave4PressureSpawnSlots.clear(); restored.retryNow();
                check(restored.spawnCalls.size() == 1, "repeated restore must not duplicate pack");
            }
            case "reset", "obsolete-generation" -> {
                p.failing.add(1); p.retryNow();
                p.clearWave4PressurePackEntities("fixture-reset"); p.clearWave4Obelisks("fixture-reset");
                p.phase = EventPhase.READY_FOR_PLAYERS; p.tickWave4ObeliskAssault();
                check(p.liveCount() == 0 && p.currentWave4PressurePackAttempts == 0
                        && p.currentWave4PressureRetryAtMillis == 0, "reset left retry state or orphan pack");
                p.generation++; p.phase = EventPhase.WAVE_4; p.failing.clear();
                if (scenario.equals("obsolete-generation")) {
                    Entity stale = p.spawn(EntityType.SPIDER, 99); stale.generation--;
                    stale.data.values.put(p.keyWave4PressureSlot, "STALKER:0");
                }
                var obelisk = new Wave4ObeliskRuntimeState(); p.activeWave4Obelisks.put(obelisk.id, obelisk);
                p.retryNow(); check(p.liveCount() == 6 && p.currentWave4MobsStarted, "new generation failed to restart");
            }
            default -> throw new AssertionError("unknown scenario " + scenario);
        }
        System.out.println("Wave4PackRuntimeProbe OK " + scenario);
    }
    // PRODUCTION_METHODS
}
