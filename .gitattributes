*.sh text eol=lf
*.bash text eol=lf
resourcepacks/src/assets/copimine/items/end_rift_rift_bolt.json text eol=lf
resourcepacks/src/assets/copimine/items/end_rift_void_burst.json text eol=lf
resourcepacks/src/assets/copimine/items/end_rift_dragon_breath.json text eol=lf
resourcepacks/src/assets/copimine/models/item/end_rift_rift_bolt.json text eol=lf
resourcepacks/src/assets/copimine/models/item/end_rift_void_burst.json text eol=lf
resourcepacks/src/assets/copimine/models/item/end_rift_dragon_breath.json text eol=lf
# Packaged plugin resources are hashed into the pinned candidate. A runner
# with core.autocrlf=true must not rewrite them, or the same sources build a
# jar 400 bytes longer (CRLF) and the pin cannot match.
copimine-end-event/config.yml text eol=lf
copimine-end-event/plugin.yml text eol=lf

# The client jar is pinned by digest and these resources are packaged verbatim,
# so their line endings are stated here instead of being taken from each
# machine's core.autocrlf. Left implicit, the same sources produced a jar 110
# bytes longer on a runner with autocrlf=true, and no single pin could match.
tools/minecraft-26.3/client/src/main/resources/copimineclient-26.3.mixins.json text eol=lf
tools/minecraft-26.3/client/src/main/resources/assets/copimineclient/post_effect/** text eol=lf
tools/minecraft-26.3/client/src/main/resources/assets/copimineclient/shaders/post/*.fsh text eol=lf
# The legacy client tree shares these asset paths with the 26.3 build.
CopiMineClient/src/main/resources/assets/copimineclient/shaders/post/*.json text eol=lf
CopiMineClient/src/main/resources/assets/copimineclient/shaders/post/*.fsh text eol=lf
CopiMineClient/src/main/resources/copimineclient.mixins.json text eol=lf
# Shader sources that are authored outside this repo and ship byte-identical.
CopiMineClient/src/main/resources/assets/copimineclient/shaders/program/* text eol=crlf

# Supplied Chameleon geometry/animations have byte-exact hash contracts.
# Windows checkout must preserve them instead of converting LF to CRLF.
CopiMineClient/src/main/resources/assets/copimineclient/models/entity/end_rift_guardian/** -text

# Existing deterministic importer emits these generated JSON files as LF.
# Preserve their committed bytes so a Windows build does not dirty source.
CopiMineClient/src/main/resources/assets/copimineclient/geometry/end_rift_tentacle.json -text
resourcepacks/src/assets/copimine/models/item/end_event_rift_tentacle.json -text

# Wave structure generators and manifests have byte-exact reproduction tests.
resourcepacks/src/assets/copimine/models/item/end_event_rift_gate.json -text
resourcepacks/src/assets/copimine/models/item/end_event_layout_gate.json -text
