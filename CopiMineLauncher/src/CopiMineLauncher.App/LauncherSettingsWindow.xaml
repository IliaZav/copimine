<UserControl x:Class="CopiMineLauncher.App.LauncherSettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource LauncherWindowBackground}" Foreground="{StaticResource LauncherPrimaryText}">
  <UserControl.Resources>
    <Style TargetType="CheckBox" BasedOn="{StaticResource LauncherCheckBox}">
      <Setter Property="Foreground" Value="{StaticResource LauncherPrimaryText}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="CheckBoxBorder" Width="20" Height="20" CornerRadius="5" Background="{StaticResource LauncherInputSurface}" BorderBrush="{StaticResource LauncherBorder}" BorderThickness="1" Margin="0,0,10,0">
                <Path x:Name="CheckMark" Data="M4,10 L8,14 L16,6" Stroke="{StaticResource LauncherWindowBackground}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
              </Border>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource LauncherAccent}" />
                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource LauncherAccentBright}" />
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource LauncherAccent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource LauncherCard}" Margin="0,0,0,14">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="Выделение памяти" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{Binding MaximumRamMb, StringFormat={}{0} МБ}" Foreground="{StaticResource LauncherAccentBright}" FontSize="17" FontWeight="Bold" DockPanel.Dock="Right" />
            </DockPanel>
            <Slider Style="{StaticResource LauncherSlider}" Minimum="512" Maximum="{Binding MaximumRamLimitMb}" TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding MaximumRamMb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,18,0,2" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="512" Foreground="{StaticResource LauncherMutedText}" />
              <TextBlock Grid.Column="1" Text="8192" Foreground="{StaticResource LauncherMutedText}" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="16384" Foreground="{StaticResource LauncherMutedText}" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="24576" Foreground="{StaticResource LauncherMutedText}" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="{Binding MaximumRamLimitMb}" Foreground="{StaticResource LauncherMutedText}" HorizontalAlignment="Right" />
            </Grid>
            <TextBlock Text="Обычно хватает 4–8 ГБ." Foreground="{StaticResource LauncherSecondaryText}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource LauncherCard}" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="Окно игры" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14" />
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="100" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="Разрешение" Foreground="{StaticResource LauncherSecondaryText}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding ResolutionWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="16,0,8,0" />
              <TextBlock Grid.Column="2" Text="×" Foreground="{StaticResource LauncherSecondaryText}" VerticalAlignment="Center" />
              <TextBox Grid.Column="3" Text="{Binding ResolutionHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="8,0,0,0" />
            </Grid>
            <CheckBox Content="Полноэкранный режим" IsChecked="{Binding Fullscreen, Mode=TwoWay}" Foreground="{StaticResource LauncherPrimaryText}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource LauncherCard}">
          <StackPanel>
            <TextBlock Text="Папка игры" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14" />
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Папка игры" Foreground="#9eb8c3" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding InstancePath}" Foreground="{StaticResource LauncherSecondaryText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstancePath}" Margin="16,0,8,0" VerticalAlignment="Center" />
              <Button Grid.Column="2" Command="{Binding OpenInstanceFolderCommand}" Padding="10,7" ToolTip="Открыть папку игры" AutomationProperties.Name="Открыть папку игры">
                <Path Fill="{StaticResource LauncherAccent}" Width="21" Height="21" Stretch="Uniform" Data="M2,5 L8,5 L10,7 L21,7 C22.1,7 23,7.9 23,9 L23,18 C23,19.1 22.1,20 21,20 L3,20 C1.9,20 1,19.1 1,18 L1,7 C1,5.9 1.9,5 3,5 Z M3,3 C1.9,3 1,3.9 1,5 L1,7 L3,7 L3,5 L8,5 L10,7 L12,7 L10,4.5 C9.6,3.6 8.8,3 7.8,3 Z" />
              </Button>
            </Grid>
            <Separator Margin="0,8,0,16" Background="{StaticResource LauncherLine}" />
            <TextBlock Text="Стартовые настройки Minecraft" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14" />
            <CheckBox Content="Русский язык" IsChecked="{Binding UseRussianLanguageDefault, Mode=TwoWay}" Foreground="{StaticResource LauncherPrimaryText}" Margin="0,0,0,10" />
            <CheckBox Content="Отключить диктора" IsChecked="{Binding DisableNarratorDefault, Mode=TwoWay}" Foreground="{StaticResource LauncherPrimaryText}" Margin="0,0,0,10" />
            <CheckBox Content="Общая громкость — 15%" IsChecked="{Binding SetMasterVolumeToFifteenPercentDefault, Mode=TwoWay}" Foreground="{StaticResource LauncherPrimaryText}" />
            <TextBlock Text="Применяется только к параметрам, которые ещё не сохранены в игре. Окно Java скрыто." Foreground="{StaticResource LauncherMutedText}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="1" Margin="0,20,0,0">
      <TextBlock Text="Изменения вступят в силу после перезапуска игры." Foreground="{StaticResource LauncherMutedText}" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
        <Button Content="Отмена" Click="Cancel_Click" />
        <Button Content="Сохранить" Style="{StaticResource LauncherPrimaryButton}" Click="Save_Click" Margin="0" />
      </StackPanel>
    </DockPanel>
  </Grid>
</UserControl>
