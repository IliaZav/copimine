          "message": {
            "text": "The public status route has no route-level rate limit or server-side cache and sends every request to public_site_status_sync through the threadpool. Each call performs a TCP probe, optionally performs an RCON list command with a four-second socket timeout, and then queries election and treasury state. The public Nginx location exposes the route without a request-rate control, allowing repeated anonymous calls to occupy threadpool and database/network resources."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:faec7aaf1ffe8f92778187a6a465d6ba1890ae49644fd00a3fda568fe090e332"
