<Application x:Class="CopiMineLauncher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CopiMineLauncher.App">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <FontFamily x:Key="LauncherDisplayFont">Segoe UI Variable Display, Bahnschrift SemiBold</FontFamily>
        <FontFamily x:Key="LauncherBodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="LauncherDataFont">Cascadia Mono, Consolas</FontFamily>

        <SolidColorBrush x:Key="LauncherColors" Color="#07111F" />
        <SolidColorBrush x:Key="LauncherWindowBackground" Color="#07111F" />
        <SolidColorBrush x:Key="LauncherPrimaryText" Color="#F4F7FF" />
        <SolidColorBrush x:Key="LauncherSecondaryText" Color="#B4C0D5" />
        <SolidColorBrush x:Key="LauncherMutedText" Color="#7888A2" />
        <SolidColorBrush x:Key="LauncherAccent" Color="#59D6D0" />
        <SolidColorBrush x:Key="LauncherAccentBright" Color="#9BE7FF" />
        <SolidColorBrush x:Key="LauncherAccentPurple" Color="#A797FF" />
        <SolidColorBrush x:Key="LauncherAccentAmber" Color="#F5C977" />
        <SolidColorBrush x:Key="LauncherSurface" Color="#A6112033" />
        <SolidColorBrush x:Key="LauncherSurfaceStrong" Color="#D90C182B" />
        <SolidColorBrush x:Key="LauncherSurfaceRaised" Color="#D91A2C43" />
        <SolidColorBrush x:Key="LauncherBorder" Color="#8059D6D0" />
        <SolidColorBrush x:Key="LauncherLine" Color="#5A59D6D0" />
        <SolidColorBrush x:Key="LauncherButtonSurface" Color="#C0122740" />
        <SolidColorBrush x:Key="LauncherButtonHover" Color="#D52A4B62" />
        <SolidColorBrush x:Key="LauncherButtonSheen" Color="#59D6D0" />
        <SolidColorBrush x:Key="LauncherInputSurface" Color="#D9081525" />
        <SolidColorBrush x:Key="LauncherRailSurface" Color="#D9071423" />
        <SolidColorBrush x:Key="LauncherSuccessSurface" Color="#B51B3150" />

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource LauncherBodyFont}" />
            <Setter Property="Foreground" Value="{StaticResource LauncherPrimaryText}" />
        </Style>

        <Style x:Key="LauncherButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{StaticResource LauncherPrimaryText}" />
            <Setter Property="Background" Value="{StaticResource LauncherButtonSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource LauncherBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource LauncherBodyFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="ButtonSheen"
                                        Background="{StaticResource LauncherButtonSheen}"
                                        CornerRadius="8"
                                        Opacity="0" />
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource LauncherAccent}" />
                                <Setter TargetName="ButtonSheen" Property="Opacity" Value="0.15" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource LauncherAccentBright}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LauncherPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource LauncherButton}">
            <Setter Property="Background" Value="{StaticResource LauncherAccent}" />
            <Setter Property="Foreground" Value="{StaticResource LauncherWindowBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource LauncherAccentBright}" />
            <Setter Property="FontFamily" Value="{StaticResource LauncherDisplayFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="MinHeight" Value="56" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource LauncherAccentBright}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LauncherRailButton" TargetType="{x:Type Button}" BasedOn="{StaticResource LauncherButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="13,11" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource LauncherButtonHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LauncherStackButton" TargetType="{x:Type Button}" BasedOn="{StaticResource LauncherButton}">
            <Setter Property="Margin" Value="0,0,0,9" />
            <Setter Property="MinHeight" Value="42" />
        </Style>

        <Style x:Key="LauncherCompactButton" TargetType="{x:Type Button}" BasedOn="{StaticResource LauncherButton}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="36" />
        </Style>

        <Style x:Key="LauncherIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource LauncherButton}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="LauncherSliderThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="{StaticResource LauncherAccent}" />
            <Setter Property="BorderBrush" Value="{StaticResource LauncherAccentBright}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LauncherSliderRepeatButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LauncherSlider" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Foreground" Value="{StaticResource LauncherAccent}" />
            <Setter Property="Background" Value="{StaticResource LauncherInputSurface}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid>
                            <Border Height="4"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource LauncherInputSurface}"
                                    CornerRadius="2" />
                            <Track x:Name="PART_Track"
                                   Focusable="False"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Orientation="{TemplateBinding Orientation}"
                                   Value="{TemplateBinding Value}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="{StaticResource LauncherAccent}"
                                                  Style="{StaticResource LauncherSliderRepeatButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="{StaticResource LauncherInputSurface}"
                                                  Style="{StaticResource LauncherSliderRepeatButton}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource LauncherSliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LauncherCheckBox" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource LauncherPrimaryText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBoxBorder"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="4"
                                    Background="{StaticResource LauncherInputSurface}"
                                    BorderBrush="{StaticResource LauncherBorder}"
                                    BorderThickness="1"
                                    Margin="0,0,10,0">
                                <Path x:Name="CheckMark"
                                      Data="M4,9 L8,13 L15,5"
                                      Stroke="{StaticResource LauncherWindowBackground}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource LauncherAccent}" />
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource LauncherAccentBright}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource LauncherAccent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource LauncherAccentPurple}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBoxBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource LauncherCheckBox}" />

        <Style x:Key="LauncherCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource LauncherLine}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,16,20,20" />
        </Style>

        <Style x:Key="LauncherHeroCard" TargetType="{x:Type Border}" BasedOn="{StaticResource LauncherCard}">
            <Setter Property="Background" Value="{StaticResource LauncherSurfaceStrong}" />
            <Setter Property="BorderBrush" Value="#996B8AFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="LauncherRule" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource LauncherLine}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style x:Key="LauncherTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource LauncherInputSurface}" />
            <Setter Property="Foreground" Value="{StaticResource LauncherPrimaryText}" />
            <Setter Property="BorderBrush" Value="{StaticResource LauncherBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource LauncherBodyFont}" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Margin" Value="0,6,0,12" />
            <Setter Property="MinHeight" Value="40" />
        </Style>

        <Style x:Key="LauncherComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{StaticResource LauncherInputSurface}" />
            <Setter Property="Foreground" Value="{StaticResource LauncherPrimaryText}" />
            <Setter Property="BorderBrush" Value="{StaticResource LauncherBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource LauncherBodyFont}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,6,0,11" />
            <Setter Property="MinHeight" Value="40" />
        </Style>

        <Style x:Key="LauncherProgressBar" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="10" />
            <Setter Property="Background" Value="#B8071324" />
            <Setter Property="Foreground" Value="{StaticResource LauncherAccent}" />
            <Setter Property="BorderBrush" Value="{StaticResource LauncherBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="LauncherLoadingSpinner" TargetType="{x:Type Ellipse}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stroke" Value="{StaticResource LauncherWindowBackground}" />
            <Setter Property="StrokeThickness" Value="3" />
            <Setter Property="StrokeDashArray" Value="2 5" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="SpinLauncher">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="360" Duration="0:0:0.8" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="SpinLauncher" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource LauncherButton}" />
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource LauncherTextBox}" />
        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource LauncherComboBox}" />
    </Application.Resources>
</Application>
