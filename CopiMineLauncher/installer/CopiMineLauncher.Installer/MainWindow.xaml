<Window x:Class="CopiMineLauncher.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка CopiMine Launcher"
        Width="760"
        Height="680"
        MinWidth="700"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource WindowBackground}"
        Icon="pack://application:,,,/Assets/copimine.ico">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Width="58" Height="58" CornerRadius="14" Background="#164A43" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
        <Image Source="pack://application:,,,/Assets/copimine-icon.png" Stretch="Uniform" Margin="8" />
      </Border>
      <StackPanel Grid.Column="1" Margin="16,2,0,0">
        <TextBlock Text="COPIMINE" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" />
        <TextBlock Text="Установка Launcher" FontSize="28" FontWeight="Bold" Margin="0,2,0,0" />
        <TextBlock Text="Minecraft 1.21.1 · Fabric 0.19.3 · Windows x64" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="Куда установить игру?" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="Launcher, Minecraft, Fabric и официальный набор модов будут установлены в выбранную папку." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,7,0,16" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="InstallPathBox" IsReadOnly="True" FontSize="14" Padding="12,9" Background="#09221F" Foreground="{StaticResource TextPrimary}" BorderBrush="#2B7665" />
          <Button Grid.Column="1" x:Name="BrowseButton" Content="Обзор…" Click="BrowseButton_OnClick" Background="#1B4E45" Foreground="{StaticResource TextPrimary}" BorderBrush="#3D8E79" />
        </Grid>
        <TextBlock Text="Launcher и Minecraft будут установлены прямо в указанную папку." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,10,0,0" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="#0B241F" BorderBrush="#18483F" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="Что будет сделано" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Text="✓ Launcher и ярлык на рабочем столе" Margin="0,14,0,0" />
        <TextBlock Text="✓ Minecraft 1.21.1 и Fabric Loader 0.19.3" Margin="0,8,0,0" />
        <TextBlock Text="✓ Java 21 и обязательные моды CopiMine" Margin="0,8,0,0" />
        <TextBlock Text="После установки Launcher докачает актуальные файлы с сервера CopiMine и проверит их целостность." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,16,0,0" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="3">
      <StackPanel VerticalAlignment="Center">
        <ProgressBar x:Name="InstallProgress" Width="190" Height="5" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource Accent}" />
        <TextBlock x:Name="StatusText" Text="Готово к установке" Foreground="{StaticResource TextMuted}" Margin="0,7,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="Закрыть" Click="CancelButton_OnClick" Background="#173A34" Foreground="{StaticResource TextPrimary}" BorderBrush="#2B6658" />
        <Button x:Name="InstallButton" Content="Установить" Click="InstallButton_OnClick" Background="{StaticResource Accent}" Foreground="#062019" BorderBrush="{StaticResource Accent}" FontWeight="Bold" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
