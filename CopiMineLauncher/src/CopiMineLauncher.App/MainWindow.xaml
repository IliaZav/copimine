<Window x:Class="CopiMineLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CopiMineLauncher.App"
        mc:Ignorable="d"
        Title="CopiMine Launcher"
        Icon="/CopiMineLauncher.App;component/Assets/copimine.ico"
        Width="1360" Height="860" MinWidth="1180" MinHeight="720"
        Background="{StaticResource LauncherWindowBackground}"
        Foreground="{StaticResource LauncherPrimaryText}"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <Image Source="Assets/LauncherVisuals/launcher-home-background.png"
           Stretch="UniformToFill"
           Opacity="0.86"
           IsHitTestVisible="False" />
    <Border IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#80061210" Offset="0" />
          <GradientStop Color="#4A081A18" Offset="0.52" />
          <GradientStop Color="#B007100E" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Grid x:Name="HomeView" Margin="28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Background="#E6122722"
              BorderBrush="#B83D755B"
              BorderThickness="1"
              CornerRadius="18"
              Padding="16"
              Margin="0,0,0,18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Image Grid.Column="0"
                 Source="Assets/LauncherVisuals/copimine-icon.png"
                 Width="58"
                 Height="58"
                 Stretch="Uniform"
                 Margin="0,0,14,0" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="COPIMINE" Foreground="{StaticResource LauncherAccentBright}" FontSize="12" FontWeight="Bold" />
            <TextBlock Text="Launcher" FontSize="28" FontWeight="Bold" Margin="0,1,0,0" />
            <TextBlock Text="Minecraft 1.21.1  ·  Fabric 0.19.3  ·  Windows x64"
                       Foreground="{StaticResource LauncherSecondaryText}"
                       FontSize="12"
                       Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border x:Name="HeaderAnimationCard"
                    Width="248"
                    Height="76"
                    Background="#B30B211B"
                    BorderBrush="#9962E39B"
                    BorderThickness="1"
                    CornerRadius="13"
                    ClipToBounds="True"
                    ToolTip="Живая анимация CopiMine">
              <Grid>
                <Border x:Name="HeaderAnimationGlow"
                        Background="#2862E39B"
                        CornerRadius="13"
                        Opacity="0.38"
                        IsHitTestVisible="False">
                  <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                      <BeginStoryboard Name="HeaderGlowPulse">
                        <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                          <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                           From="0.24"
                                           To="0.82"
                                           Duration="0:0:1.4" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                  </Border.Triggers>
                </Border>
                <local:AnimatedGifImage GifSource="Assets/LauncherVisuals/copimine-logo-header.gif"
                                        FallbackSource="Assets/LauncherVisuals/copimine-logo.png"
                                        IsPlaying="True"
                                        Width="222"
                                        Height="62"
                                        Stretch="Uniform"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,10,7"
                            IsHitTestVisible="False">
                  <Ellipse x:Name="HeaderLiveDot"
                           Width="7"
                           Height="7"
                           Fill="{StaticResource LauncherAccentBright}"
                           RenderTransformOrigin="0.5,0.5"
                           Margin="0,0,5,0">
                    <Ellipse.RenderTransform>
                      <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                      <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard Name="HeaderLivePulse">
                          <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="0.78"
                                             To="1.35"
                                             Duration="0:0:0.85" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="0.78"
                                             To="1.35"
                                             Duration="0:0:0.85" />
                          </Storyboard>
                        </BeginStoryboard>
                      </EventTrigger>
                    </Ellipse.Triggers>
                  </Ellipse>
                  <TextBlock Text="LIVE"
                             Foreground="{StaticResource LauncherAccentBright}"
                             FontSize="9"
                             FontWeight="Bold"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </Border>
            <WrapPanel HorizontalAlignment="Right" MaxWidth="420">
              <Button Style="{StaticResource LauncherCompactButton}"
                      Content="Скины"
                      Click="OpenSkins_Click"
                      Margin="0,8,6,0"
                      ToolTip="Открыть скины, плащи и 3D-предпросмотр" />
              <Button Style="{StaticResource LauncherCompactButton}"
                      Content="Настройки"
                      Click="OpenSettings_Click"
                      Margin="0,8,6,0" />
              <Button Style="{StaticResource LauncherCompactButton}"
                      Command="{Binding OpenWebsiteCommand}"
                      Content="Сайт"
                      Margin="0,8,6,0" />
              <Button Style="{StaticResource LauncherCompactButton}"
                      Command="{Binding OpenDiscordCommand}"
                      Content="Discord"
                      Margin="0,8,6,0" />
              <Button Style="{StaticResource LauncherCompactButton}"
                      Command="{Binding ApplySelfUpdateCommand}"
                      Content="{Binding SelfUpdateActionText}"
                      Margin="0,8,0,0" />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="340" />
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource LauncherCard}" Padding="22,20">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
              <TextBlock Text="ИГРА" Foreground="{StaticResource LauncherAccentBright}" FontSize="11" FontWeight="Bold" />
              <TextBlock Text="Готово к запуску" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
              <TextBlock Text="Синхронизируем файлы и запускаем Minecraft одной кнопкой."
                         Foreground="{StaticResource LauncherSecondaryText}"
                         TextWrapping="Wrap"
                         Margin="0,8,0,18" />
            </StackPanel>

            <StackPanel Grid.Row="1">
              <TextBlock Text="Имя игрока" Foreground="{StaticResource LauncherSecondaryText}" />
              <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=LostFocus}"
                       MaxLength="16"
                       AutomationProperties.Name="Имя игрока" />
              <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Папка игры"
                           Foreground="{StaticResource LauncherSecondaryText}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource LauncherIconButton}"
                        Command="{Binding OpenInstanceFolderCommand}"
                        ToolTip="Открыть папку игры"
                        AutomationProperties.Name="Открыть папку игры">
                  <Path Fill="{StaticResource LauncherAccent}"
                        Stretch="Uniform"
                        Data="M2,5 L8,5 L10,7 L21,7 C22.1,7 23,7.9 23,9 L23,18 C23,19.1 22.1,20 21,20 L3,20 C1.9,20 1,19.1 1,18 L1,7 C1,5.9 1.9,5 3,5 Z M3,3 C1.9,3 1,3.9 1,5 L1,7 L3,7 L3,5 L8,5 L10,7 L12,7 L10,4.5 C9.6,3.6 8.8,3 7.8,3 Z" />
                </Button>
              </Grid>
              <TextBlock Text="{Binding InstancePath}"
                         Foreground="{StaticResource LauncherMutedText}"
                         FontSize="11"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding InstancePath}"
                         Margin="0,0,0,12" />
            </StackPanel>

            <StackPanel Grid.Row="2" VerticalAlignment="Top">
              <Button Command="{Binding PlayCommand}"
                      Style="{StaticResource LauncherPrimaryButton}"
                      Margin="0,3,0,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Ellipse Style="{StaticResource LauncherLoadingSpinner}"
                           Margin="0,0,9,0"
                           VerticalAlignment="Center" />
                  <TextBlock Text="{Binding PlayButtonText}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Command="{Binding RepairCommand}"
                      Style="{StaticResource LauncherStackButton}"
                      Content="Проверить файлы" />
              <Button Command="{Binding OpenAccountLinkCommand}"
                      Style="{StaticResource LauncherStackButton}"
                      Content="Привязать аккаунт" />
              <Border Background="#243F45"
                      BorderBrush="#3E7B74"
                      BorderThickness="1"
                      CornerRadius="9"
                      Padding="11"
                      Margin="0,0,0,12"
                      Visibility="{Binding LauncherLinkRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                  <TextBlock Text="Привязка аккаунта обязательна перед запуском. После авторизации на сайте можно закрыть браузер — Launcher получит подтверждение автоматически."
                             Foreground="#D1F1E6"
                             TextWrapping="Wrap"
                             FontSize="12" />
                  <Button Command="{Binding OpenAccountLinkCommand}"
                          Content="Открыть страницу привязки"
                          Style="{StaticResource LauncherStackButton}"
                          Margin="0,10,0,0"
                          Padding="10,7" />
                </StackPanel>
              </Border>
            </StackPanel>

            <Border Grid.Row="3"
                    Background="#B10D1B18"
                    BorderBrush="#543D755B"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="12">
              <StackPanel>
                <TextBlock Text="СЕРВЕР" Foreground="{StaticResource LauncherAccentBright}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="mc.copimine.ru" FontSize="17" FontWeight="Bold" Margin="0,5,0,2" />
                <TextBlock Text="Сервер добавится в список Minecraft автоматически."
                           Foreground="{StaticResource LauncherMutedText}"
                           TextWrapping="Wrap"
                           FontSize="11" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="158" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0"
                  Style="{StaticResource LauncherCard}"
                  Padding="0"
                  ClipToBounds="True">
            <Grid>
              <Image Source="Assets/LauncherVisuals/update-background.png"
                     Stretch="UniformToFill"
                     Opacity="0.46"
                     IsHitTestVisible="False" />
              <Border IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F0122520" Offset="0" />
                    <GradientStop Color="#98132A25" Offset="0.62" />
                    <GradientStop Color="#3D1B3930" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Grid Margin="20,17">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="СОСТОЯНИЕ" Foreground="{StaticResource LauncherAccentBright}" FontSize="11" FontWeight="Bold" />
                  <TextBlock Text="{Binding Status}" FontSize="21" FontWeight="Bold" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding LoadingStage}"
                             Foreground="{StaticResource LauncherSecondaryText}"
                             TextWrapping="Wrap"
                             Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                  <StackPanel Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              Visibility="{Binding IsLatestVersionVerified, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="✓"
                               Foreground="{StaticResource LauncherAccentBright}"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,5,0" />
                    <TextBlock Text="Последняя версия установлена"
                               Foreground="{StaticResource LauncherAccentBright}"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding SelfUpdateStatus}"
                             Foreground="{StaticResource LauncherSecondaryText}"
                             FontSize="11"
                             TextWrapping="Wrap"
                             HorizontalAlignment="Right"
                             MaxWidth="245"
                             TextAlignment="Right"
                             Margin="0,0,0,3" />
                  <TextBlock Text="{Binding ProgressLabel}"
                             Foreground="{StaticResource LauncherAccentBright}"
                             FontSize="25"
                             FontWeight="Bold"
                             HorizontalAlignment="Right" />
                  <TextBlock Text="синхронизация"
                             Foreground="{StaticResource LauncherMutedText}"
                             FontSize="11"
                             HorizontalAlignment="Right" />
                  <Button Style="{StaticResource LauncherCompactButton}"
                          Command="{Binding CheckSelfUpdateCommand}"
                          Content="Проверить обновление"
                          Margin="0,10,0,0" />
                </StackPanel>
              </Grid>
              <ProgressBar Value="{Binding ProgressPercent}"
                           IsIndeterminate="{Binding IsProgressIndeterminate}"
                           Style="{StaticResource LauncherProgressBar}"
                           VerticalAlignment="Bottom"
                           Margin="20,0,20,15" />
            </Grid>
          </Border>

          <Border Grid.Row="2" Style="{StaticResource LauncherCard}" Padding="18">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Последние новости" FontSize="21" FontWeight="Bold" />
                  <TextBlock Text="Обновления сборки и короткие заметки команды"
                             Foreground="{StaticResource LauncherSecondaryText}"
                             FontSize="11"
                             Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource LauncherCompactButton}"
                        Command="{Binding RefreshNewsCommand}"
                        Content="Обновить"
                        Margin="12,0,0,0" />
              </Grid>

              <ScrollViewer Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <Grid>
                  <ItemsControl ItemsSource="{Binding PatchCards}"
                                Visibility="{Binding HasPatchCards, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#A6142825"
                                BorderBrush="#6C3D755B"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="13"
                                Margin="0,0,0,10">
                          <StackPanel>
                            <Border Height="88"
                                    Background="{StaticResource LauncherInputSurface}"
                                    BorderBrush="{StaticResource LauncherBorder}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Margin="0,0,0,11">
                              <Grid>
                                <Image Source="{Binding ArtworkPath}" Stretch="UniformToFill" Opacity="0.88" />
                                <Border Background="#8F07120F" IsHitTestVisible="False" />
                              </Grid>
                            </Border>
                            <DockPanel>
                              <TextBlock Text="{Binding Version}" Foreground="{StaticResource LauncherAccentBright}" FontWeight="Bold" />
                              <TextBlock Text="{Binding PublishedAt}" Foreground="{StaticResource LauncherMutedText}" DockPanel.Dock="Right" />
                            </DockPanel>
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Margin="0,6,0,3" />
                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource LauncherSecondaryText}" TextWrapping="Wrap" />
                            <Button Style="{StaticResource LauncherCompactButton}"
                                    Command="{Binding DataContext.OpenPatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="Подробнее"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Grid Visibility="{Binding HasPatchCards, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                        MinHeight="172">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="12" ClipToBounds="True" Margin="0,0,6,0">
                      <Image Source="Assets/LauncherVisuals/news-01.png" Stretch="UniformToFill" />
                    </Border>
                    <Border Grid.Column="1" CornerRadius="12" ClipToBounds="True" Margin="3,0,3,0">
                      <Image Source="Assets/LauncherVisuals/news-02.png" Stretch="UniformToFill" />
                    </Border>
                    <Border Grid.Column="2" CornerRadius="12" ClipToBounds="True" Margin="6,0,0,0">
                      <Image Source="Assets/LauncherVisuals/news-03.png" Stretch="UniformToFill" />
                    </Border>
                    <Border Grid.ColumnSpan="3"
                            VerticalAlignment="Bottom"
                            Background="#D20A1512"
                            Padding="13,9"
                            CornerRadius="0,0,12,12">
                      <StackPanel>
                        <TextBlock Text="Новости пока недоступны" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Показываем сохранённый визуальный набор. Попробуйте обновить позже."
                                   Foreground="{StaticResource LauncherSecondaryText}"
                                   FontSize="11"
                                   Margin="0,3,0,0" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Grid>
              </ScrollViewer>

              <TextBlock Grid.Row="2"
                         Text="Новости подгружаются с сайта и сохраняются локально для следующего запуска."
                         Foreground="{StaticResource LauncherMutedText}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Margin="0,12,0,0" />
            </Grid>
          </Border>

          <Expander Grid.Row="3"
                    Header="Диагностика"
                    IsExpanded="{Binding IsDiagnosticOpen, Mode=TwoWay}"
                    Foreground="{StaticResource LauncherSecondaryText}"
                    Background="#D0122722"
                    BorderBrush="{StaticResource LauncherBorder}"
                    BorderThickness="1"
                    Padding="12,8"
                    Margin="0,14,0,0">
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0"
                       Text="{Binding Diagnostic, Mode=OneWay}"
                       IsReadOnly="True"
                       IsTabStop="True"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="0"
                       Foreground="{StaticResource LauncherSecondaryText}"
                       FontFamily="Consolas"
                       FontSize="12"
                       Margin="0,0,12,0" />
              <Button Grid.Column="1"
                      Style="{StaticResource LauncherCompactButton}"
                      Command="{Binding DiagnoseCommand}"
                      Content="Проверить состояние" />
            </Grid>
          </Expander>
        </Grid>
      </Grid>

      <Border Grid.Row="2"
              Background="#D00B1714"
              BorderBrush="#663D755B"
              BorderThickness="1"
              CornerRadius="10"
              Padding="11"
              Margin="0,18,0,0">
        <DockPanel>
          <TextBlock Text="{Binding Status}" Foreground="{StaticResource LauncherSecondaryText}" />
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" MaxWidth="650">
            <TextBlock Text="Данные Launcher: " Foreground="{StaticResource LauncherMutedText}" />
            <TextBlock Text="{Binding LauncherDataPath}"
                       Foreground="{StaticResource LauncherMutedText}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding LauncherDataPath}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>

    <Grid x:Name="ScreenView" Margin="28" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="BackButton"
                Grid.Column="0"
                Content="←"
                Click="BackFromScreen_Click"
                Width="44"
                Height="42"
                Padding="0"
                FontSize="23"
                ToolTip="Назад"
                AutomationProperties.Name="Назад" />
        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="РАЗДЕЛ LAUNCHER" Foreground="{StaticResource LauncherAccentBright}" FontSize="11" FontWeight="Bold" />
          <TextBlock x:Name="ScreenTitleText" Text="Настройки" FontSize="25" FontWeight="Bold" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
      <ContentControl x:Name="ScreenContent" Grid.Row="1" />
    </Grid>

    <local:LauncherLoadingOverlay Panel.ZIndex="50"
                                  IsSplashVisible="{Binding IsInitializing}"
                                  IsOperationVisible="{Binding IsBusy}"
                                  IsHitTestVisible="{Binding IsOperationInputBlocked}"
                                  Stage="{Binding LoadingStage}"
                                  Progress="{Binding ProgressPercent}"
                                  IsIndeterminate="{Binding IsProgressIndeterminate}"
                                  ProgressLabel="{Binding ProgressLabel}" />
  </Grid>
</Window>
