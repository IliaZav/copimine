<UserControl x:Class="CopiMineLauncher.App.MinecraftDefaultsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0b141c"
             Foreground="#eef7f5">
  <UserControl.Resources>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#eef7f5" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Margin" Value="0,0,0,14" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="CheckBoxBorder" Width="22" Height="22" CornerRadius="6" Background="#0b1a26" BorderBrush="#376276" BorderThickness="1" Margin="0,0,12,0">
                <Path x:Name="CheckMark" Data="M4,11 L9,16 L18,6" Stroke="#06150d" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
              </Border>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#63dfa0" />
                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#8af5bb" />
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#63dfa0" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#edf7f4" />
      <Setter Property="Background" Value="#173044" />
      <Setter Property="BorderBrush" Value="#2c5367" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#45d483" />
      <Setter Property="Foreground" Value="#06150d" />
      <Setter Property="BorderBrush" Value="#7af0aa" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="34">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="760">
        <Border Background="#122332" BorderBrush="#2d6274" BorderThickness="1" CornerRadius="18" Padding="26" Margin="0,0,0,16">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="46" Height="46" Background="#193c4d" CornerRadius="13" Padding="9" Margin="0,0,14,0">
                <Image Source="Assets/copimine-logo.png" Stretch="Uniform" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ПЕРВЫЙ ЗАПУСК" Foreground="#63dfa0" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="Настройка Minecraft" FontSize="25" FontWeight="Bold" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="Выберите стартовые параметры игры. Их можно изменить позже в настройках Minecraft." Foreground="#b1c7ce" FontSize="14" TextWrapping="Wrap" Margin="0,22,0,0" />
          </StackPanel>
        </Border>

        <Border Background="#122332" BorderBrush="#284858" BorderThickness="1" CornerRadius="18" Padding="26">
          <StackPanel>
            <TextBlock Text="Параметры по умолчанию" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18" />
            <CheckBox Content="Русский язык" IsChecked="{Binding UseRussianLanguageDefault, Mode=TwoWay}" />
            <CheckBox Content="Отключить диктора" IsChecked="{Binding DisableNarratorDefault, Mode=TwoWay}" />
            <CheckBox Content="Общая громкость — 15%" IsChecked="{Binding SetMasterVolumeToFifteenPercentDefault, Mode=TwoWay}" Margin="0" />
            <TextBlock Text="Выбранные значения применяются только если игрок ещё не менял этот параметр." Foreground="#718b96" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="1" Margin="0,22,0,0">
      <TextBlock Text="Minecraft установится в выбранную при установке папку." Foreground="#718b96" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440" />
      <Button Content="Сохранить и продолжить" Style="{StaticResource PrimaryButton}" Click="Save_Click" HorizontalAlignment="Right" Margin="12,0,0,0" />
    </DockPanel>
  </Grid>
</UserControl>
