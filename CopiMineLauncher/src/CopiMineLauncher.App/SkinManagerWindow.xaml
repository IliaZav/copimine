<UserControl x:Class="CopiMineLauncher.App.SkinManagerWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{StaticResource LauncherWindowBackground}" Foreground="{StaticResource LauncherPrimaryText}">
  <UserControl.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource LauncherButton}">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource LauncherPrimaryButton}">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource LauncherButton}">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource LauncherCompactButton}">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource LauncherTextBox}">
      <Setter Property="Margin" Value="0,5,0,8" />
    </Style>
    <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource LauncherPrimaryText}" />
      <Setter Property="Background" Value="{StaticResource LauncherSurfaceStrong}" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource LauncherButtonHover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#E63B715F" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
      <Grid>
        <ToggleButton x:Name="ToggleButton"
                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                      ClickMode="Press"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}"
                      Foreground="{TemplateBinding Foreground}"
                      Content="{TemplateBinding SelectionBoxItem}"
                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}">
          <ToggleButton.Template>
            <ControlTemplate TargetType="ToggleButton">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                  <Path Grid.Column="1" Data="M 0 0 L 8 0 L 4 5 Z" Fill="#7af0aa" Width="8" Height="5" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,2,0" />
                </Grid>
              </Border>
            </ControlTemplate>
          </ToggleButton.Template>
        </ToggleButton>
        <Popup x:Name="Popup" Placement="Bottom" VerticalOffset="2" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
            <Border Background="{StaticResource LauncherSurfaceStrong}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="3" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
            <ScrollViewer MaxHeight="280" SnapsToDevicePixels="True">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
            </ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter TargetName="ToggleButton" Property="Opacity" Value="0.5" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="ComboBox" BasedOn="{StaticResource LauncherComboBox}">
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="Margin" Value="0,5,0,8" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Template" Value="{StaticResource DarkComboBoxTemplate}" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
    </Style>
    <Style x:Key="SkinListItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Background" Value="{StaticResource LauncherSurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource LauncherBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{StaticResource LauncherButtonHover}" />
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LauncherAccent}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Card" Property="Background" Value="#E63B715F" />
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LauncherAccent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="310" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="270" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource LauncherCard}" Padding="14" Margin="0,0,12,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Text="Каталог скинов" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Каталог Ely.by" Foreground="{StaticResource LauncherMutedText}" FontSize="11" Margin="0,4,0,10" TextWrapping="Wrap" />
            <TextBox x:Name="TagsTextBox" ToolTip="Например: winter, fantasy" />
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="SortComboBox" SelectedIndex="0" SelectionChanged="CatalogFilterChanged">
              <ComboBoxItem Content="Популярные" Tag="best" />
              <ComboBoxItem Content="Новые" Tag="time" />
            </ComboBox>
            <ComboBox Grid.Column="1" x:Name="TypeComboBox" SelectedIndex="0" SelectionChanged="CatalogFilterChanged" Margin="7,5,0,8">
              <ComboBoxItem Content="Все модели" Tag="any" />
              <ComboBoxItem Content="Slim / Alex" Tag="slim" />
              <ComboBoxItem Content="Classic / Steve" Tag="new" />
            </ComboBox>
          </Grid>
          <StackPanel Grid.Row="2">
            <CheckBox x:Name="SensitiveCheckBox" Content="Показывать чувствительный контент" Foreground="#b1c7ce" Margin="0,0,0,8" />
            <Button Style="{StaticResource ActionButton}" Content="Загрузить каталог" Click="LoadCatalog_Click" />
          </StackPanel>
          <TabControl Grid.Row="3" Background="{StaticResource LauncherInputSurface}" BorderBrush="{StaticResource LauncherBorder}" BorderThickness="1" Foreground="{StaticResource LauncherPrimaryText}">
            <TabItem Header="Скины" Padding="10,5">
              <ListBox x:Name="CatalogListBox" SelectionChanged="CatalogSelectionChanged" PreviewMouseLeftButtonDown="CatalogCardMouseDown" ItemContainerStyle="{StaticResource SkinListItem}" Background="{StaticResource LauncherInputSurface}" BorderThickness="0" Foreground="{StaticResource LauncherPrimaryText}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Width="56" Height="68" Background="{StaticResource LauncherInputSurface}" BorderBrush="{StaticResource LauncherBorder}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,10,0">
                        <Image Source="{Binding ThumbnailPath}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" ToolTip="Предпросмотр скина" />
                      </Border>
                      <StackPanel Grid.Column="1">
                        <DockPanel>
                        <TextBlock Text="Скин" Foreground="{StaticResource LauncherAccentBright}" FontWeight="Bold" />
                          <TextBlock Text="{Binding Id, StringFormat=№ {0}}" Foreground="{StaticResource LauncherMutedText}" DockPanel.Dock="Right" />
                        </DockPanel>
                        <TextBlock Text="{Binding Tags, StringFormat=Теги: {0}}" Foreground="{StaticResource LauncherSecondaryText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding IsSlim, StringFormat=Модель Slim: {0}}" Foreground="{StaticResource LauncherMutedText}" FontSize="11" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
            <TabItem Header="Плащи по нику" Padding="10,5">
              <Grid Background="{StaticResource LauncherInputSurface}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Плащи для выбранного ника" Foreground="{StaticResource LauncherMutedText}" FontSize="11" TextWrapping="Wrap" Margin="8,8,8,6" />
                <ListBox Grid.Row="1" x:Name="CapeListBox" SelectionChanged="CapeSelectionChanged" PreviewMouseLeftButtonDown="CapeCardMouseDown" ItemContainerStyle="{StaticResource SkinListItem}" Background="{StaticResource LauncherInputSurface}" BorderThickness="0" Foreground="{StaticResource LauncherPrimaryText}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="64" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="56" Height="56" Background="{StaticResource LauncherInputSurface}" BorderBrush="{StaticResource LauncherBorder}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,10,0">
                          <Image Source="{Binding ThumbnailPath}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" ToolTip="Предпросмотр плаща" />
                        </Border>
                        <StackPanel Grid.Column="1">
                          <DockPanel>
                          <TextBlock Text="Плащ" Foreground="{StaticResource LauncherAccentBright}" FontWeight="Bold" />
                          <TextBlock Text="{Binding Type}" Foreground="{StaticResource LauncherSecondaryText}" DockPanel.Dock="Right" />
                          </DockPanel>
                          <TextBlock Text="{Binding PlayerName, StringFormat=Ник: {0}}" Foreground="{StaticResource LauncherMutedText}" FontSize="11" Margin="0,5,0,0" />
                          <TextBlock Text="{Binding Animated, StringFormat=Анимация источника: {0}}" Foreground="{StaticResource LauncherMutedText}" FontSize="11" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </TabItem>
          </TabControl>
          <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="CatalogPageLabel" Text="Каталог ещё не загружен" Foreground="{StaticResource LauncherMutedText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button x:Name="NextPageButton" Content="Дальше →" Click="NextPage_Click" IsEnabled="False" Padding="9,6" Margin="8,0,0,0" DockPanel.Dock="Right" />
          </DockPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="{StaticResource LauncherInputSurface}" BorderBrush="{StaticResource LauncherBorder}" BorderThickness="1" CornerRadius="16" Padding="8" Margin="0,0,12,0">
        <Grid>
          <wv2:WebView2 x:Name="PreviewView" />
          <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="#E807120F" Opacity="0.92" CornerRadius="7" Padding="9,6" Margin="10">
            <TextBlock x:Name="PreviewStatus" Text="Предпросмотр готов" Foreground="{StaticResource LauncherSecondaryText}" FontSize="11" />
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource LauncherCard}" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Мой образ" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Ваш ник" Foreground="#718b96" FontSize="11" Margin="0,4,0,6" TextWrapping="Wrap" />
            <TextBox x:Name="PlayerNameTextBox" />
            <Button Style="{StaticResource ActionButton}" Content="Найти по нику" Click="ResolveByNickname_Click" />
            <Button Style="{StaticResource ActionButton}" Content="Загрузить плащи" Click="LoadCapes_Click" />
            <TextBlock x:Name="SourceLabel" Text="Ничего не выбрано" Foreground="#9eb8c3" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

            <Separator Background="#284657" Margin="0,0,0,12" />
            <TextBlock Text="Файлы" Foreground="#9eb8c3" FontWeight="SemiBold" />
            <Button Style="{StaticResource ActionButton}" Content="Загрузить скин из файла" Click="ImportSkin_Click" />
            <Button Style="{StaticResource ActionButton}" Content="Загрузить плащ из файла" Click="ImportCape_Click" />
            <Button Style="{StaticResource PrimaryButton}" Content="Применить скин" Margin="0,0,0,10" MinHeight="36" Click="ApplySkin_Click" />
            <Button Style="{StaticResource ActionButton}" Content="Применить плащ" Click="ApplyCape_Click" />
            <TextBlock Text="Файлы лежат в папке игры. После смены перезапустите Minecraft." Foreground="#718b96" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,12" />

            <Separator Background="#284657" Margin="0,0,0,12" />
            <TextBlock Text="Предпросмотр" Foreground="#9eb8c3" FontWeight="SemiBold" />
            <TextBlock Text="Модель" Foreground="#718b96" FontSize="11" />
            <ComboBox x:Name="ModelComboBox" SelectionChanged="PreviewSettingChanged">
              <ComboBoxItem Content="Авто" Tag="auto-detect" />
              <ComboBoxItem Content="Steve · обычные руки" Tag="default" />
              <ComboBoxItem Content="Alex · тонкие руки" Tag="slim" />
            </ComboBox>
            <TextBlock Text="Анимация" Foreground="#718b96" FontSize="11" />
            <ComboBox x:Name="AnimationComboBox" SelectionChanged="PreviewSettingChanged">
              <ComboBoxItem Content="Ходьба" Tag="walking" />
              <ComboBoxItem Content="Покой" Tag="idle" />
              <ComboBoxItem Content="Бег" Tag="running" />
              <ComboBoxItem Content="Мах рукой" Tag="wave" />
              <ComboBoxItem Content="Приседание" Tag="crouch" />
              <ComboBoxItem Content="Полёт" Tag="flying" />
              <ComboBoxItem Content="Плавание" Tag="swim" />
              <ComboBoxItem Content="Получение урона" Tag="damage" />
            </ComboBox>
            <TextBlock Text="Фон" Foreground="#718b96" FontSize="11" />
            <ComboBox x:Name="BackgroundComboBox" SelectionChanged="PreviewSettingChanged">
              <ComboBoxItem Content="Ледяная долина" Tag="ice" />
              <ComboBoxItem Content="Ночное небо" Tag="night" />
              <ComboBoxItem Content="Лес" Tag="forest" />
              <ComboBoxItem Content="Закат" Tag="sunset" />
              <ComboBoxItem Content="Тёмный фон" Tag="clean" />
            </ComboBox>
            <CheckBox x:Name="AutoRotateCheckBox" Content="Автоповорот" IsChecked="True" Click="PreviewSettingChanged" Foreground="#eef7f5" Margin="0,0,0,8" />
            <TextBlock Text="Скорость анимации" Foreground="#718b96" FontSize="11" />
            <Slider x:Name="AnimationSpeedSlider" Minimum="0.25" Maximum="2.5" Value="1" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="PreviewSettingChanged" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <DockPanel Grid.Row="1" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" Text="Готово" Foreground="#9eb8c3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Button Style="{StaticResource CompactButton}" Content="Назад" Click="Back_Click" Padding="16,8" Margin="8,0,0,0" DockPanel.Dock="Right" />
    </DockPanel>
  </Grid>
</UserControl>
