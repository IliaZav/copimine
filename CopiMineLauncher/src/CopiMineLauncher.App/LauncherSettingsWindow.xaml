<Window x:Class="CopiMineLauncher.App.LauncherSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки CopiMine Launcher"
        Width="640" Height="650" MinWidth="560" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="#0b141c" Foreground="#eef7f5">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#edf7f4" />
      <Setter Property="Background" Value="#173044" />
      <Setter Property="BorderBrush" Value="#2c5367" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13,9" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#45d483" />
      <Setter Property="Foreground" Value="#06150d" />
      <Setter Property="BorderBrush" Value="#7af0aa" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0c1925" />
      <Setter Property="Foreground" Value="#eef7f5" />
      <Setter Property="BorderBrush" Value="#2b5367" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
  </Window.Resources>

  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="Настройки" Foreground="#63dfa0" FontSize="12" FontWeight="Bold" />
      <TextBlock Text="Параметры игры" FontSize="28" FontWeight="Bold" Margin="0,3,0,0" />
      <TextBlock Text="Изменения сохраняются локально и не содержат пароли AuthMe." Foreground="#9eb8c3" Margin="0,5,0,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Background="#122332" BorderBrush="#284858" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="Выделение памяти" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{Binding MaximumRamMb, StringFormat={}{0} МБ}" Foreground="#7af0aa" FontSize="17" FontWeight="Bold" DockPanel.Dock="Right" />
            </DockPanel>
            <Slider Minimum="512" Maximum="{Binding MaximumRamLimitMb}" TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding MaximumRamMb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,18,0,2" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="512" Foreground="#718b96" />
              <TextBlock Grid.Column="1" Text="8192" Foreground="#718b96" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="16384" Foreground="#718b96" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="24576" Foreground="#718b96" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="{Binding MaximumRamLimitMb}" Foreground="#718b96" HorizontalAlignment="Right" />
            </Grid>
            <TextBlock Text="Для большинства компьютеров достаточно 4096–8192 МБ." Foreground="#9eb8c3" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Background="#122332" BorderBrush="#284858" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="Окно игры" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14" />
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="100" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="Разрешение" Foreground="#9eb8c3" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding ResolutionWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="16,0,8,0" />
              <TextBlock Grid.Column="2" Text="×" Foreground="#9eb8c3" VerticalAlignment="Center" />
              <TextBox Grid.Column="3" Text="{Binding ResolutionHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="8,0,0,0" />
            </Grid>
            <CheckBox Content="Полноэкранный режим" IsChecked="{Binding Fullscreen, Mode=TwoWay}" Foreground="#eef7f5" />
          </StackPanel>
        </Border>

        <Border Background="#122332" BorderBrush="#284858" BorderThickness="1" CornerRadius="14" Padding="20">
          <StackPanel>
            <TextBlock Text="Папка и язык" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14" />
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Папка игры" Foreground="#9eb8c3" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding InstancePath}" Foreground="#b1c7ce" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstancePath}" Margin="16,0,8,0" VerticalAlignment="Center" />
              <Button Grid.Column="2" Command="{Binding OpenInstanceFolderCommand}" Padding="10,7" ToolTip="Открыть папку игры" AutomationProperties.Name="Открыть папку игры">
                <Path Fill="#7af0aa" Width="21" Height="21" Stretch="Uniform" Data="M2,5 L8,5 L10,7 L21,7 C22.1,7 23,7.9 23,9 L23,18 C23,19.1 22.1,20 21,20 L3,20 C1.9,20 1,19.1 1,18 L1,7 C1,5.9 1.9,5 3,5 Z M3,3 C1.9,3 1,3.9 1,5 L1,7 L3,7 L3,5 L8,5 L10,7 L12,7 L10,4.5 C9.6,3.6 8.8,3 7.8,3 Z" />
              </Button>
            </Grid>
            <TextBlock Text="Язык, диктор и громкость меняются внутри Minecraft. Консоль Java скрыта, диагностика сохраняется в папке игры." Foreground="#718b96" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="2" Margin="0,20,0,0">
      <TextBlock Text="Настройки применяются при следующем запуске Minecraft." Foreground="#718b96" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
        <Button Content="Отмена" Click="Cancel_Click" />
        <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
