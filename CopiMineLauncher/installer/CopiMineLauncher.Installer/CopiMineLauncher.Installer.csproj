<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CopiMineLauncherFolderSetup</AssemblyName>
    <RootNamespace>CopiMineLauncher.Installer</RootNamespace>
    <ApplicationIcon>..\..\src\CopiMineLauncher.App\Assets\copimine.ico</ApplicationIcon>
    <Version Condition="'$(Version)' == ''">1.0.3</Version>
    <InstallerMsiUrl Condition="'$(InstallerMsiUrl)' == ''">https://copimine.ru/downloads/launcher/CopiMineLauncherSetup-1.0.3.msi</InstallerMsiUrl>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="CopiMineInstallerMsiSha256" Value="$(InstallerMsiSha256)" Condition="'$(InstallerMsiSha256)' != ''" />
    <AssemblyMetadata Include="CopiMineInstallerMsiSizeBytes" Value="$(InstallerMsiSizeBytes)" Condition="'$(InstallerMsiSizeBytes)' != ''" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CopiMineLauncher.Core\CopiMineLauncher.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\src\CopiMineLauncher.App\Assets\copimine.ico" Link="Assets\copimine.ico" />
    <Resource Include="..\..\src\CopiMineLauncher.App\Assets\LauncherVisuals\copimine-icon.png" Link="Assets\copimine-icon.png" />
  </ItemGroup>
</Project>
