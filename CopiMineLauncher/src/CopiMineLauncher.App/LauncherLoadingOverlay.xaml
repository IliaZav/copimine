<UserControl x:Class="CopiMineLauncher.App.LauncherLoadingOverlay"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CopiMineLauncher.App"
             Background="Transparent">
  <UserControl.Resources>
    <Style x:Key="MotionCard" TargetType="{x:Type Border}">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform">
        <Setter.Value>
          <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:LauncherLoadingOverlay}}, Path=ReducedMotion}" Value="False">
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{x:Static local:LauncherMotion.ShortDuration}" />
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.97" To="1" Duration="{x:Static local:LauncherMotion.MediumDuration}" />
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.97" To="1" Duration="{x:Static local:LauncherMotion.MediumDuration}" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:LauncherLoadingOverlay}}, Path=ReducedMotion}" Value="True">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="RenderTransform">
            <Setter.Value>
              <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
          </Setter>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid Visibility="{Binding IsSplashVisible, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
      <local:AnimatedGifImage GifSource="Assets/LauncherVisuals/splash.gif"
                              FallbackSource="Assets/LauncherVisuals/loading-emblem.png"
                              IsPlaying="{Binding IsSplashVisible, ElementName=Root}"
                              Stretch="UniformToFill"
                              Opacity="0.50"
                              IsHitTestVisible="False" />
      <Border Background="#D007120F" IsHitTestVisible="False" />
      <Border Style="{StaticResource MotionCard}"
              Background="#ED102522"
              BorderBrush="{StaticResource LauncherBorder}"
              BorderThickness="1"
              CornerRadius="18"
              Padding="34"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              MinWidth="360">
        <StackPanel HorizontalAlignment="Center">
          <local:AnimatedGifImage GifSource="Assets/LauncherVisuals/copimine-logo-animated.gif"
                                  FallbackSource="Assets/LauncherVisuals/copimine-logo.png"
                                  IsPlaying="{Binding IsSplashVisible, ElementName=Root}"
                                  Width="220"
                                  Height="94"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,18" />
          <Image Source="Assets/LauncherVisuals/loading-emblem.png"
                 Width="82"
                 Height="82"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 Margin="0,0,0,18" />
          <TextBlock Text="Запускаем CopiMine Launcher"
                     Foreground="{StaticResource LauncherPrimaryText}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Подготавливаем игру и проверяем файлы"
                     Foreground="{StaticResource LauncherSecondaryText}"
                     FontSize="12"
                     HorizontalAlignment="Center"
                     Margin="0,7,0,18" />
          <ProgressBar Style="{StaticResource LauncherProgressBar}"
                       IsIndeterminate="True"
                       Width="280"
                       HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Visibility="{Binding IsOperationVisible, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Image Source="Assets/LauncherVisuals/update-background.png"
             Stretch="UniformToFill"
             Opacity="0.54"
             IsHitTestVisible="False" />
      <Border Background="#D407120F" IsHitTestVisible="False" />
      <Border Style="{StaticResource MotionCard}"
              Background="#F0132D2A"
              BorderBrush="{StaticResource LauncherBorder}"
              BorderThickness="1"
              CornerRadius="18"
              Padding="30"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              MinWidth="430">
        <StackPanel>
          <DockPanel Margin="0,0,0,18">
            <Image Source="Assets/LauncherVisuals/loading-emblem.png" Width="62" Height="62" Stretch="Uniform" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="CopiMine Launcher" Foreground="{StaticResource LauncherAccentBright}" FontSize="11" FontWeight="Bold" />
              <TextBlock Text="Подготовка игры" Foreground="{StaticResource LauncherPrimaryText}" FontSize="21" FontWeight="SemiBold" Margin="0,3,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding ProgressLabel, ElementName=Root}" Foreground="{StaticResource LauncherAccentBright}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right" />
          </DockPanel>
          <TextBlock Text="{Binding Stage, ElementName=Root}"
                     Foreground="{StaticResource LauncherSecondaryText}"
                     FontSize="13"
                     TextWrapping="Wrap"
                     Margin="0,0,0,10" />
          <Grid Height="10" ClipToBounds="True">
            <ProgressBar Style="{StaticResource LauncherProgressBar}"
                         Value="{Binding Progress, ElementName=Root}"
                         IsIndeterminate="{Binding IsIndeterminate, ElementName=Root}"
                         Height="10" />
            <Border Width="120"
                    Height="10"
                    Background="#9C8AF3B3"
                    HorizontalAlignment="Left"
                    Visibility="{Binding IsIndeterminate, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Border.RenderTransform>
                <TranslateTransform X="-140" />
              </Border.RenderTransform>
              <Border.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-140" To="560" Duration="0:0:1.4" RepeatBehavior="Forever" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Border.Triggers>
            </Border>
          </Grid>
          <TextBlock Text="Файлы и настройки остаются на месте при обновлении."
                     Foreground="{StaticResource LauncherMutedText}"
                     FontSize="11"
                     Margin="0,12,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
