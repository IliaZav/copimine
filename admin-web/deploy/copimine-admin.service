[Unit]
Description=CopiMine Ultimate Admin Web Panel
# The startup preflight performs a real PostgreSQL query.  The cluster unit
# can be started in parallel with the web panel during boot; ordering the
# panel behind the cluster avoids the transient "database system is starting
# up" failure that otherwise exhausts systemd's restart burst.
Requires=postgresql@16-main.service
After=network.target postgresql@16-main.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=copimine
WorkingDirectory=/opt/copimine/admin-web
EnvironmentFile=/opt/copimine/admin-web/.env
Environment=COPIMINE_ENV_FILE=/opt/copimine/admin-web/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/copimine/admin-web/backend:/opt/copimine/admin-web
ExecStartPre=/opt/copimine/admin-web/.venv/bin/python -m backend.startup_checks --strict
# The application validates forwarded headers itself after confirming that the
# TCP peer is the loopback nginx relay.  Uvicorn's proxy-header mode rewrites
# request.client to the public visitor IP and would make valid Origin/TLS
# checks look untrusted.
ExecStart=/opt/copimine/admin-web/.venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8090
Restart=always
RestartSec=3
TimeoutStartSec=180
TimeoutStopSec=30
KillMode=mixed
# The panel has a tightly scoped sudoers rule for Minecraft start/stop/restart
# actions used by the admin controls and recipe apply flow.
NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
